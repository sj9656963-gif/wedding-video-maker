{
  "name": "wedding-video-maker",
  "private": true,
  "version": "1.0.0",
  "description": "사진을 한 번에 올리면 3~5분 분량의 웨딩 식전영상(MP4)을 브라우저에서 바로 만들어 주는 웹사이트",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:edge": "node e2e/edge.mjs",
    "e2e:visual": "node e2e/visual.mjs",
    "e2e:pwa": "node e2e/pwa.mjs",
    "e2e:live": "node e2e/live.mjs"
