{
  "name": "wedding-video-maker",
  "private": true,
  "version": "1.0.0",
  "description": "사진을 한 번에 올리면 3~5분 분량의 웨딩 식전영상(MP4)을 브라우저에서 바로 만들어 주는 웹사이트",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:edge": "node e2e/edge.mjs",
    "e2e:visual": "node e2e/visual.mjs",
    "e2e:pwa": "node e2e/pwa.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/black-han-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/gowun-batang": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "mediabunny": "1.60.0",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
